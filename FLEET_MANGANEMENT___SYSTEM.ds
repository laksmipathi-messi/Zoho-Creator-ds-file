		payment	{
			test1 as "test"
			{
				type =  payment
				form = Fuel_Details
				amount field = Cost_per_liter
				on success
				{
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : "zoho.loginuserid"
								subject : "Payment Notification"
								message : "<!doctype html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Email Templates</title>\n</head>\n<body>\n<table width=\"750\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tr>\n    <td valign=\"top\" align=\"center\">\n   <div style=\" width:750px; padding:20px; font-family:Lato,Arial,Helvetica,sans-serif; font-size:14px; color:#000; text-align:left;\">\n          <div style=\"background:#33bc6e; height:76px; text-align:center; padding-top:20px; display:block\">\n            <div style=\"font-size:15px; color:#fff;padding-bottom:6px;\">Payment Received</div>\n            <div style=\"font-size:30px; color:#fff; \">${Cost_per_liter} INR</div> \n       </div>\n        <div style=\"padding:40px; background:#fbfbfb;\">\n        <div style=\"padding:0px 0 0 0; font-size:14px; color:#000; font-weight:bold;\">Dear ${zoho.loginuserid},</div>\n        <div style=\"padding:10px 0 70px 0; font-size:13px; color:#000; line-height:22px;\"> We’re delighted to let you know that your payment of ${Cost_per_liter} INR was successful. \n          Thank you for choosing us and we hope you had a great  experience. </div>\n        <div style=\"padding:40px 0 0 0; font-size:14px; color:#000;font-weight:bold;\">Regards,</div>\n        <div style=\"padding:8px 0 0 0; font-size:14px; color:#000;\">${zoho.adminuserid}</div>\n      </div>\n      <div style=\"height:2px; overflow:hidden;line-height:0px;background:#33bc6e;\"></div>\n   	  </div>\n      </td>\n  </tr>\n</table>\n</body>\n</html>"
							)
						}
