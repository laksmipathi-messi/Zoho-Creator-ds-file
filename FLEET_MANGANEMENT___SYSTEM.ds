		reports
		{
			report All_Vehicle_Details
			{
				quickview
				(
					layout
					(
						displaylayout = "classic"
		 				type = 2
						datablock1
						(
							layout type = 4
							fields
							(
								Vehicle_No as "Vehicle No"
								Vehicle_Type as "Vehicle Type "
								Vehicle_ID as "Vehicle ID"
								Vehicle_Model as "Vehicle Model"
								Vehicle as " Vehicle Status"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
