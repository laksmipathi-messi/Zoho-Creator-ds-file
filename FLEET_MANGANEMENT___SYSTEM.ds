		schedule
		{
			schedule_ittt as "schedule ittt"
			{
				type =  schedule
					status = inactive
				start = "2026-09-17 18:15:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						today = zoho.currentdate;
										vehicles = Vehicle_Details[ID != 0];
										for each  vehicle in vehicles
										{
											// =========================
											// INSURANCE
											// =========================
											if(vehicle.Insurance_Expiry_Date != null)
											{
												days_left = today.daysBetween(vehicle.Insurance_Expiry_Date);
												if(days_left < 0)
												{
													message = "🔴 CRITICAL - Insurance Expired\n\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Insurance_Expiry_Date.toString("dd-MMM-yyyy");
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection");
												}
												else if(days_left <= 30)
												{
													message = "⚠️ VEHICLE EXPIRY ALERT\n\nDocument: Insurance\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Insurance_Expiry_Date.toString("dd-MMM-yyyy") + "\nDays Remaining: " + days_left;
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection");
												}
											}
											// =========================
											// REGISTRATION / RC
											// =========================
											if(vehicle.Registration_Expiry != null)
											{
												days_left = today.daysBetween(vehicle.Registration_Expiry);
												if(days_left < 0)
												{
													message = "🔴 CRITICAL - Registration Expired\n\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Registration_Expiry.toString("dd-MMM-yyyy");
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection");
												}
												else if(days_left <= 30)
												{
													message = "⚠️ VEHICLE EXPIRY ALERT\n\nDocument: Registration / RC\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Registration_Expiry.toString("dd-MMM-yyyy") + "\nDays Remaining: " + days_left;
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection");
												}
											}
											// =========================
											// POLLUTION
											// =========================
											if(vehicle.Pollution_Certificate_Expiry != null)
											{
												days_left = today.daysBetween(vehicle.Pollution_Certificate_Expiry);
												if(days_left < 0)
												{
													message = "🔴 CRITICAL - Pollution Certificate Expired\n\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Pollution_Certificate_Expiry.toString("dd-MMM-yyyy");
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection");
												}
												else if(days_left <= 30)
												{
													message = "⚠️ VEHICLE EXPIRY ALERT\n\nDocument: Pollution Certificate\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Pollution_Certificate_Expiry.toString("dd-MMM-yyyy") + "\nDays Remaining: " + days_left;
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection");
												}
											}
										}
					)
					}
				}
			}
			schedule_Date_expriy as "schedule Date expriy"
			{
				type =  schedule
				start = "2026-09-18 15:20:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						today = zoho.currentdate;
										vehicles = Vehicle_Details[ID != 0];
										info "Scheduler Started";
										info "Today: " + today;
										info "Vehicle Count: " + vehicles.count();
										for each  vehicle in vehicles
										{
											info "Checking Vehicle: " + vehicle.Vehicle_No;
											// ================= INSURANCE =================
											if(vehicle.Insurance_Expiry_Date != null)
											{
												days_left = today.daysBetween(vehicle.Insurance_Expiry_Date);
												info "Insurance Expiry: " + vehicle.Insurance_Expiry_Date;
												info "Insurance Days Left: " + days_left;
												if(days_left < 0)
												{
													message = "🔴 CRITICAL - Insurance Expired\n\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Insurance_Expiry_Date.toString("dd-MMM-yyyy");
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection1");
													info response;
												}
												else if(days_left <= 30)
												{
													message = "⚠️ VEHICLE EXPIRY ALERT\n\nDocument: Insurance" + "\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Insurance_Expiry_Date.toString("dd-MMM-yyyy") + "\nDays Remaining: " + days_left;
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection1");
													info response;
												}
											}
											// ================= REGISTRATION =================
											if(vehicle.Registration_Expiry != null)
											{
												days_left = today.daysBetween(vehicle.Registration_Expiry);
												info "Registration Expiry: " + vehicle.Registration_Expiry;
												info "Registration Days Left: " + days_left;
												if(days_left < 0)
												{
													message = "🔴 CRITICAL - Registration Expired\n\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Registration_Expiry.toString("dd-MMM-yyyy");
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection1");
													info response;
												}
												else if(days_left <= 30)
												{
													message = "⚠️ VEHICLE EXPIRY ALERT\n\nDocument: Registration / RC" + "\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Registration_Expiry.toString("dd-MMM-yyyy") + "\nDays Remaining: " + days_left;
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection1");
													info response;
												}
											}
											// ================= POLLUTION =================
											if(vehicle.Pollution_Certificate_Expiry != null)
											{
												days_left = today.daysBetween(vehicle.Pollution_Certificate_Expiry);
												info "Pollution Expiry: " + vehicle.Pollution_Certificate_Expiry;
												info "Pollution Days Left: " + days_left;
												if(days_left < 0)
												{
													message = "🔴 CRITICAL - Pollution Certificate Expired\n\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Pollution_Certificate_Expiry.toString("dd-MMM-yyyy");
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection1");
													info response;
												}
												else if(days_left <= 30)
												{
													message = "⚠️ VEHICLE EXPIRY ALERT\n\nDocument: Pollution Certificate" + "\nVehicle: " + vehicle.Vehicle_No + "\nExpiry Date: " + vehicle.Pollution_Certificate_Expiry.toString("dd-MMM-yyyy") + "\nDays Remaining: " + days_left;
													response = zoho.cliq.postToChannel("fleetmanagementsystem",message,"zoho_cliq_connection1");
													info response;
												}
											}
										}
										info "Scheduler Completed";
					)
					}
				}
			}
