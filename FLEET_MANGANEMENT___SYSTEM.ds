				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Insurance_Expiry_Date
			(
    			type = date
				displayname = "Insurance Expiry"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Registration_Expiry
			(
    			type = date
				displayname = "Registration Expiry"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have Pollution_Certificate_Expiry
			(
    			type = date
				displayname = "Pollution Certificate Expiry"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 3   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Resume","Accept","Reject","Apptitude","Accepted apptitude","Rejected","Offer"}
			}
		}
	}
	reports
	{
		default kanban All_Vehicle_Details
		{
			displayName = "All Vehicle Details"
			show all rows from Vehicle_Details    
			(
				Vehicle_No as "Vehicle No"
				Vehicle_Type as "Vehicle Type "
				Vehicle_Model as "Vehicle Model"
				Purchase_Date as "Purchase  Date "
				Fuel_Type as "Fuel Type"
				Current_Odameter as "Current  Odometer"
				Vehicle as " Vehicle Status"
				Auto_Number as "Auto Number"
				Insurance_Expiry_Date as "Insurance Expiry"
				Registration_Expiry as "Registration Expiry"
				Pollution_Certificate_Expiry as "Pollution Certificate Expiry"
				Fuel_consumption1 as "Fuel consumption "
				Meliage
				Vehicle_ID as "Vehicle ID"
			)
			options
			(
	 			display field = Vehicle_Type
	 		)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Vehicle == "Available")
				fields = [Vehicle]
				format = "font-weight:bold;background-color:#38d7bb;"
				}
				"New Formatting"
				{
				condition = (Vehicle == "In Use")
				fields = [Vehicle]
				format = "font-weight:bold;background-color:#11b1cc;"
				}
				"New Formatting"
				{
				condition = (Vehicle == "Under Maintenance")
				fields = [Vehicle]
				format = "font-weight:bold;color:#ffffff;background-color:#7c7c7c;"
				}
			)
		}
		default summary All_Diver_Details
		{
			displayName = "All Diver Details"
			show all rows from Diver_Details    
			(
				Diver_Name  as "Diver Name "
				Diver_ID as "Diver ID"
				License_Number as "License Number"
				License_Type as "License Type"
				License_Expiry as "License Expiry"
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Status
				License_issue_date as "License issue date"
				Location
				Email
				demo as "demo "
			)
			options
			(
				display rows = 10
				display records per row = 2
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Status == "Active")
				fields = [Status]
				format = "font-weight:bold;color:#595959;background-color:#398ef3;"
				}
				"New Formatting"
				{
				condition = (Status == "IN-Active")
				fields = [Status]
				format = "font-weight:bold;background-color:#cc115e;"
				}
			)
		}
		default kanban All_Fuel_Details
		{
			displayName = "All Fuel Details"
			show all rows from Fuel_Details    
			(
				Vehicle as "Vehicle   Type"
				fuel_date as "fuel date"
				fuel as "fuel  Qunatity"
				fuel_Rate as "fuel Rate "
				Station_Location as "Station Location"
				Cost_per_liter as "Cost per liter"
				Fuel_Type as "Fuel Type"
				Current_Odometer as "Current Odometer"
				Vehicle_Model as "Vehicle  Model"
				vehicle_NO as "vehicle NO"
			)
			options
			(
	 			display field = Vehicle
	 		)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Vehicle.Fuel_Type == "Petrol")
				fields = [Vehicle]
				format = "font-weight:bold;color:#ffffff;background-color:#efb116;"
				}
				"New Formatting"
				{
				condition = (Vehicle_Model.Fuel_Type == "Diesel")
				fields = [Vehicle]
				format = "font-weight:bold;background-color:#d2e9d1;"
				}
				"New Formatting"
				{
				condition = (Vehicle_Model.Fuel_Type == "Petrol")
				fields = [Fuel_Type]
				format = "font-weight:bold;color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting"
				{
				condition = (Vehicle.Fuel_Type == "Diesel")
				fields = [Fuel_Type]
				format = "font-weight:bold;color:#595959;background-color:#3598db;"
				}
			)
		}
		default kanban Maintenance_details_Report
		{
			displayName = "Maintenance  details Report"
			show all rows from Maintenance_details    
			(
				Vehicle_NO as "Vehicle NO"
				Maintenance_type as "Maintenance type"
				Service_Date as "Service Date"
				Cost
				next_Service_Odometer as "next Service  Odometer"
				Odometer
				Service_Provider as "Service Provider"
				Next_Service as "Next Service "
				Status
			)
			options
			(
	 			display field = Maintenance_type
	 		)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Maintenance_type]
				format = "color:#ffffff;background-color:#107c91;"
				}
			)
		}
		default kanban All_Trip_Details
		{
			displayName = "All Trip Details"
			show all rows from Trip_details    
			(
				Empolyee_ID as "Empolyee ID"
				Employee_name as "Employee  name"
				Trip_date as "Trip  date"
				Trip_NO as "Trip NO"
				Distance_Covered as "Distance  Covered"
				Vehicle_Type as "Vehicle Type"
				Vehicle_No as "Vehicle No"
				Purpose
				Source
				Destination
				trip_Status as "trip  Status"
				Start_Odometer as "Start Odometer"
				End_Odometer as "End Odometer"
				Empolyee_ID.Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Empolyee_ID.Employee_image as "Employee image"
			)
			options
			(
	 			display field = Empolyee_ID
	 		)
		}
		default list All_Empolyee_Details
		{
			displayName = "All Empolyee Details"
			show all rows from Empolyee_details    
			(
				Employee_name  as "Employee name "
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Email
				Employee_iD as "Employee iD"
				Employee_image as "Employee image"
				Department
				Roles
				Modified_User as "Modified User"
				Added_User as "Added User"
				Added_Time as "Added Time"
			)
		}
		default kanban Vechicle_Docmuments_Report
		{
			displayName = "Vechicle Docmuments Report"
			show all rows from Vechicle_Docmuments    
			(
				Vehicle_No as "Vehicle No"
				Vehicle_No.Vehicle_ID as "Vehicle ID"
				Vehicle_No.Vehicle_No as "Vehicle No"
				Vehicle_No.Vehicle_Model as "Vehicle Model"
				Vehicle_No.Vehicle_Type as "Vehicle Type "
				Insurance_Expiry as "Insurance Expiry"
				Pollution_Certificate_Expiry as "Pollution Certificate Expiry"
				Registration_Expiry as "Registration Expiry"
			)
			options
			(
	 			display field = Vehicle_No
	 		)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Vehicle_No]
				format = "font-weight:bold;color:#ffffff;background-color:#107c91;"
				}
			)
		}
		default list All_Roles
		{
			displayName = "All Roles"
			show all rows from Roles    
			(
				Role
				Dpet as "Department"
			)
		}
	}
	pages
	{
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\ttotal_vehicles = Vehicle_Details[ID != null].count();\n\tavailable_vehicles = Vehicle_Details[Vehicle == &quot;Available&quot;].count();\n\tin_use_vehicles = Vehicle_Details[Vehicle == &quot;In Use&quot;].count();\n\tmaintenance_vehicles = Vehicle_Details[Vehicle == &quot;Under Maintenance&quot;].count();\n\tinactive_vehicles = Vehicle_Details[Vehicle == &quot;Inactive&quot;].count();\n\ttotal_drivers = Diver_Details[ID != null].count();\n\tactive_drivers = Diver_Details[Status == &quot;Active&quot;].count();\n\ttotal_employees = Empolyee_details[ID != null].count();\n\ttotal_fuel_records = Fuel_Details[ID != null].count();\n\ttotal_maintenance = Maintenance_details[ID != null].count();\n\ttotal_trips = Trip_details[ID != null].count();\n\ttotal_documents = Vechicle_Docmuments[ID != null].count();\n\t%&gt;\nexpiring_insurance = Vehicle_Details[\n\tInsurance_Expiry_Date != null &amp;&amp;\n\tInsurance_Expiry_Date &gt;= zoho.currentdate &amp;&amp;\n\tInsurance_Expiry_Date &lt;= zoho.currentdate.addDay(30)\n].count();\n\nexpiring_registration = Vehicle_Details[\n\tRegistration_Expiry != null &amp;&amp;\n\tRegistration_Expiry &gt;= zoho.currentdate &amp;&amp;\n\tRegistration_Expiry &lt;= zoho.currentdate.addDay(30)\n].count();\n\nexpiring_pollution = Vehicle_Details[\n\tPollution_Certificate_Expiry != null &amp;&amp;\n\tPollution_Certificate_Expiry &gt;= zoho.currentdate &amp;&amp;\n\tPollution_Certificate_Expiry &lt;= zoho.currentdate.addDay(30)\n].count();\n\nexpiring_documents = expiring_insurance + expiring_registration + expiring_pollution;\n\n\n/* =========================\n   UPCOMING MAINTENANCE\n   Future Service_Date within 30 days\n\n   Note:\n   Export contains Service_Date only,\n   not a separate Next_Service_Date.\n   ========================= */\n\nupcoming_services = Maintenance_details[\n\tService_Date != null &amp;&amp;\n\tService_Date &gt;= zoho.currentdate &amp;&amp;\n\tService_Date &lt;= zoho.currentdate.addDay(30)\n].count();\n\n\n/* =========================\n   TRIP STATUS\n   ========================= */\n\nrequested_trips = Trip_details[\n\ttrip_Status == &quot;Requested&quot;\n].count();\n\napproved_trips = Trip_details[\n\ttrip_Status == &quot;Approved&quot;\n].count();\n\nstarted_trips = Trip_details[\n\ttrip_Status == &quot;Started&quot;\n].count();\n\ncompleted_trips = Trip_details[\n\ttrip_Status == &quot;Completed&quot;\n].count();\n\ncancelled_trips = Trip_details[\n\ttrip_Status == &quot;Cancelled&quot;\n].count();\n\n\n/* =========================\n   VEHICLE TYPE\n   ========================= */\n\ncar_count = Vehicle_Details[\n\tVehicle_Type == &quot;Car&quot;\n].count();\n\nsuv_count = Vehicle_Details[\n\tVehicle_Type == &quot;SUV&quot;\n].count();\n\nvan_count = Vehicle_Details[\n\tVehicle_Type == &quot;Van&quot;\n].count();\n\n\n/* =========================\n   FUEL TYPE\n   ========================= */\n\npetrol_count = Vehicle_Details[\n\tFuel_Type == &quot;Petrol&quot;\n].count();\n\ndiesel_count = Vehicle_Details[\n\tFuel_Type == &quot;Diesel&quot;\n].count();\n```\n\n\n\n&lt;style&gt;\n\n* {\n\tbox-sizing: border-box;\n\tmargin: 0;\n\tpadding: 0;\n\tfont-family: Arial, Helvetica, sans-serif;\n}\n\nbody {\n\tbackground: #1d508e;\n\tcolor: #ffffff;\n}\n\n.fleet-dashboard {\n\tmin-height: 100vh;\n\tpadding: 24px;\n\tbackground:\n\t\tradial-gradient(circle at top right, rgba(46,183,159,0.20), transparent 30%),\n\t\t#1d508e;\n}\n\n\n/* =========================\n   HEADER\n   ========================= */\n\n.dashboard-header {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tmargin-bottom: 25px;\n}\n\n.brand-area {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 15px;\n}\n\n.brand-icon {\n\twidth: 52px;\n\theight: 52px;\n\tborder-radius: 14px;\n\tbackground: #2eb79f;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\tfont-size: 25px;\n\tbox-shadow: 0 10px 25px rgba(0,0,0,0.20);\n}\n\n.brand-title {\n\tfont-size: 26px;\n\tfont-weight: 700;\n}\n\n.brand-subtitle {\n\tcolor: rgba(255,255,255,0.70);\n\tmargin-top: 4px;\n\tfont-size: 13px;\n}\n\n.header-date {\n\tbackground: rgba(255,255,255,0.10);\n\tborder: 1px solid rgba(255,255,255,0.15);\n\tpadding: 12px 18px;\n\tborder-radius: 12px;\n\tfont-size: 13px;\n}\n\n\n/* =========================\n   QUICK NAVIGATION\n   ========================= */\n\n.quick-nav {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(7, 1fr);\n\tgap: 10px;\n\tmargin-bottom: 24px;\n}\n\n.nav-button {\n\ttext-decoration: none;\n\tcolor: #ffffff;\n\tbackground: rgba(255,255,255,0.10);\n\tborder: 1px solid rgba(255,255,255,0.13);\n\tborder-radius: 12px;\n\tpadding: 13px 8px;\n\ttext-align: center;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttransition: 0.2s;\n}\n\n.nav-button:hover {\n\tbackground: #2eb79f;\n\ttransform: translateY(-2px);\n}\n\n.nav-icon {\n\tfont-size: 18px;\n\tdisplay: block;\n\tmargin-bottom: 5px;\n}\n\n\n/* =========================\n   SECTION TITLE\n   ========================= */\n\n.section-title {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tmargin: 20px 0 12px;\n}\n\n.section-title h2 {\n\tfont-size: 17px;\n}\n\n.section-title span {\n\tfont-size: 12px;\n\tcolor: rgba(255,255,255,0.65);\n}\n\n\n/* =========================\n   KPI CARDS\n   ========================= */\n\n.kpi-grid {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(4, 1fr);\n\tgap: 15px;\n}\n\n.kpi-card {\n\tbackground: #ffffff;\n\tcolor: #182635;\n\tborder-radius: 17px;\n\tpadding: 20px;\n\tposition: relative;\n\toverflow: hidden;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.16);\n}\n\n.kpi-card::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\tright: -30px;\n\ttop: -30px;\n\twidth: 100px;\n\theight: 100px;\n\tborder-radius: 50%;\n\tbackground: rgba(46,183,159,0.12);\n}\n\n.kpi-top {\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: center;\n}\n\n.kpi-icon {\n\twidth: 42px;\n\theight: 42px;\n\tborder-radius: 12px;\n\tbackground: rgba(46,183,159,0.13);\n\tcolor: #2eb79f;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\tfont-size: 20px;\n}\n\n.kpi-label {\n\tfont-size: 12px;\n\tcolor: #73808d;\n\tmargin-top: 15px;\n}\n\n.kpi-value {\n\tfont-size: 30px;\n\tfont-weight: 700;\n\tmargin-top: 4px;\n\tcolor: #172536;\n}\n\n.kpi-link {\n\tdisplay: inline-block;\n\tmargin-top: 10px;\n\tfont-size: 11px;\n\tcolor: #2eb79f;\n\ttext-decoration: none;\n\tfont-weight: 600;\n}\n\n\n/* =========================\n   STATUS CARDS\n   ========================= */\n\n.status-grid {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(4, 1fr);\n\tgap: 15px;\n}\n\n.status-card {\n\tbackground: rgba(255,255,255,0.10);\n\tborder: 1px solid rgba(255,255,255,0.13);\n\tborder-radius: 15px;\n\tpadding: 18px;\n}\n\n.status-name {\n\tfont-size: 12px;\n\tcolor: rgba(255,255,255,0.70);\n}\n\n.status-value {\n\tfont-size: 26px;\n\tfont-weight: 700;\n\tmargin-top: 8px;\n}\n\n.status-bar {\n\theight: 5px;\n\tbackground: rgba(255,255,255,0.15);\n\tborder-radius: 20px;\n\tmargin-top: 14px;\n\toverflow: hidden;\n}\n\n.status-fill {\n\theight: 100%;\n\tbackground: #2eb79f;\n\tborder-radius: 20px;\n}\n\n\n/* =========================\n   TWO COLUMN AREA\n   ========================= */\n\n.content-grid {\n\tdisplay: grid;\n\tgrid-template-columns: 1fr 1fr;\n\tgap: 18px;\n\tmargin-top: 18px;\n}\n\n.panel {\n\tbackground: rgba(255,255,255,0.10);\n\tborder: 1px solid rgba(255,255,255,0.13);\n\tborder-radius: 17px;\n\tpadding: 20px;\n}\n\n.panel h3 {\n\tfont-size: 16px;\n\tmargin-bottom: 18px;\n}\n\n\n/* =========================\n   METRIC ROW\n   ========================= */\n\n.metric-row {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 11px 0;\n\tborder-bottom: 1px solid rgba(255,255,255,0.09);\n}\n\n.metric-row:last-child {\n\tborder-bottom: 0;\n}\n\n.metric-name {\n\tfont-size: 13px;\n\tcolor: rgba(255,255,255,0.75);\n}\n\n.metric-value {\n\tfont-size: 14px;\n\tfont-weight: 700;\n\tcolor: #ffffff;\n}\n\n.metric-action {\n\ttext-decoration: none;\n\tcolor: #2eb79f;\n\tfont-size: 11px;\n}\n\n\n/* =========================\n   QUICK ACTIONS\n   ========================= */\n\n.action-grid {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(4, 1fr);\n\tgap: 12px;\n}\n\n.action-card {\n\ttext-decoration: none;\n\tcolor: #ffffff;\n\tbackground: rgba(255,255,255,0.08);\n\tborder: 1px solid rgba(255,255,255,0.12);\n\tpadding: 18px 12px;\n\tborder-radius: 14px;\n\ttext-align: center;\n\ttransition: 0.2s;\n}\n\n.action-card:hover {\n\tbackground: #2eb79f;\n\ttransform: translateY(-3px);\n}\n\n.action-icon {\n\tfont-size: 25px;\n\tmargin-bottom: 8px;\n}\n\n.action-title {\n\tfont-size: 12px;\n\tfont-weight: 600;\n}\n\n\n/* =========================\n   FOOTER\n   ========================= */\n\n.dashboard-footer {\n\ttext-align: center;\n\tmargin-top: 25px;\n\tcolor: rgba(255,255,255,0.55);\n\tfont-size: 11px;\n}\n\n\n/* =========================\n   CREATOR PAGE WIDTH\n   ========================= */\n\n#zcPageLiveHtml {\n\tbackground: #1d508e !important;\n}\n\n\n/* =========================\n   RESPONSIVE\n   ========================= */\n\n@media(max-width: 1000px) {\n\n\t.quick-nav {\n\t\tgrid-template-columns: repeat(4, 1fr);\n\t}\n\n\t.kpi-grid,\n\t.status-grid {\n\t\tgrid-template-columns: repeat(2, 1fr);\n\t}\n\n\t.content-grid {\n\t\tgrid-template-columns: 1fr;\n\t}\n\n}\n\n@media(max-width: 600px) {\n\n\t.fleet-dashboard {\n\t\tpadding: 14px;\n\t}\n\n\t.dashboard-header {\n\t\talign-items: flex-start;\n\t\tgap: 12px;\n\t\tflex-direction: column;\n\t}\n\n\t.quick-nav {\n\t\tgrid-template-columns: repeat(2, 1fr);\n\t}\n\n\t.kpi-grid,\n\t.status-grid,\n\t.action-grid {\n\t\tgrid-template-columns: 1fr;\n\t}\n\n}\n\n&lt;/style&gt;\n\n&lt;div class=&quot;fleet-dashboard&quot;&gt;\n\n```\n&lt;!-- =========================\n     HEADER\n     ========================= --&gt;\n\n&lt;div class=&quot;dashboard-header&quot;&gt;\n\n\t&lt;div class=&quot;brand-area&quot;&gt;\n\n\t\t&lt;div class=&quot;brand-icon&quot;&gt;\n\t\t\t\uD83D\uDE99\n\t\t&lt;/div&gt;\n\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;brand-title&quot;&gt;\n\t\t\t\tFleet Management System\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;brand-subtitle&quot;&gt;\n\t\t\t\tVehicle \u2022 Driver \u2022 Fuel \u2022 Maintenance \u2022 Trip Management\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;header-date&quot;&gt;\n\t\tUpdated: &lt;%=zoho.currentdate%&gt;\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n\n\n&lt;!-- =========================\n     QUICK NAVIGATION\n     ========================= --&gt;\n\n&lt;div class=&quot;quick-nav&quot;&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Vehicle_Details&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\uD83D\uDE99&lt;/span&gt;\n\t\tVehicle\n\t&lt;/a&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Diver_Details&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\uD83D\uDC64&lt;/span&gt;\n\t\tDiver\n\t&lt;/a&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Empolyee_details&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\uD83D\uDC65&lt;/span&gt;\n\t\tEmployee\n\t&lt;/a&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Fuel_Details&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\u26FD&lt;/span&gt;\n\t\tFuel\n\t&lt;/a&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Maintenance_details&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\uD83D\uDD27&lt;/span&gt;\n\t\tMaintenance\n\t&lt;/a&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Trip_details&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\uD83D\uDEE3\uFE0F&lt;/span&gt;\n\t\tTrip\n\t&lt;/a&gt;\n\n\t&lt;a class=&quot;nav-button&quot; href=&quot;#Form:Vechicle_Docmuments&quot;&gt;\n\t\t&lt;span class=&quot;nav-icon&quot;&gt;\uD83D\uDCC4&lt;/span&gt;\n\t\tDocuments\n\t&lt;/a&gt;\n\n&lt;/div&gt;\n\n\n&lt;!-- =========================\n     MAIN KPI\n     ========================= --&gt;\n\n&lt;div class=&quot;section-title&quot;&gt;\n\t&lt;h2&gt;Fleet Overview&lt;/h2&gt;\n\t&lt;span&gt;Live records from Creator forms&lt;/span&gt;\n&lt;/div&gt;\n\n\n&lt;div class=&quot;kpi-grid&quot;&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Total Vehicles&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=total_vehicles%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\uD83D\uDE99\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:All_Vehicle_Details&quot;&gt;\n\t\t\tView All Vehicles \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Available Vehicles&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=available_vehicles%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\u2713\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:All_Vehicle_Details&quot;&gt;\n\t\t\tView Vehicle Status \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Vehicles In Use&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=in_use_vehicles%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\u2197\uFE0F\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:All_Vehicle_Details&quot;&gt;\n\t\t\tView Fleet \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Under Maintenance&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=maintenance_vehicles%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\uD83D\uDD27\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:Maintenance_details_Report&quot;&gt;\n\t\t\tView Maintenance \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Active Drivers&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=active_drivers%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\uD83D\uDC64\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:All_Diver_Details&quot;&gt;\n\t\t\tView Drivers \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\u26A0\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:Vechicle_Docmuments_Report&quot;&gt;\n\t\t\tView Documents \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\uD83D\uDEE0\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:Maintenance_details_Report&quot;&gt;\n\t\t\tView Services \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;kpi-card&quot;&gt;\n\n\t\t&lt;div class=&quot;kpi-top&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Total Trips&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=total_trips%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;\n\t\t\t\t\uD83D\uDEE3\uFE0F\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;a class=&quot;kpi-link&quot; href=&quot;#Report:All_Trip_Details&quot;&gt;\n\t\t\tView Trips \u2192\n\t\t&lt;/a&gt;\n\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n\n\n&lt;!-- =========================\n     VEHICLE STATUS\n     ========================= --&gt;\n\n&lt;div class=&quot;section-title&quot;&gt;\n\t&lt;h2&gt;Vehicle Status&lt;/h2&gt;\n\t&lt;span&gt;&lt;%=total_vehicles%&gt; total vehicles&lt;/span&gt;\n&lt;/div&gt;\n\n\n&lt;div class=&quot;status-grid&quot;&gt;\n\n\n\t&lt;div class=&quot;status-card&quot;&gt;\n\n\t\t&lt;div class=&quot;status-name&quot;&gt;\n\t\t\tAvailable\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-value&quot;&gt;\n\t\t\t&lt;%=available_vehicles%&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-bar&quot;&gt;\n\t\t\t&lt;div\n\t\t\t\tclass=&quot;status-fill&quot;\n\t\t\t\tstyle=&quot;width:&lt;%=if(total_vehicles &gt; 0,available_vehicles * 100 / total_vehicles,0)%&gt;%;&quot;&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;status-card&quot;&gt;\n\n\t\t&lt;div class=&quot;status-name&quot;&gt;\n\t\t\tIn Use\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-value&quot;&gt;\n\t\t\t&lt;%=in_use_vehicles%&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-bar&quot;&gt;\n\t\t\t&lt;div\n\t\t\t\tclass=&quot;status-fill&quot;\n\t\t\t\tstyle=&quot;width:&lt;%=if(total_vehicles &gt; 0,in_use_vehicles * 100 / total_vehicles,0)%&gt;%;&quot;&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;status-card&quot;&gt;\n\n\t\t&lt;div class=&quot;status-name&quot;&gt;\n\t\t\tUnder Maintenance\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-value&quot;&gt;\n\t\t\t&lt;%=maintenance_vehicles%&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-bar&quot;&gt;\n\t\t\t&lt;div\n\t\t\t\tclass=&quot;status-fill&quot;\n\t\t\t\tstyle=&quot;width:&lt;%=if(total_vehicles &gt; 0,maintenance_vehicles * 100 / total_vehicles,0)%&gt;%;&quot;&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;div class=&quot;status-card&quot;&gt;\n\n\t\t&lt;div class=&quot;status-name&quot;&gt;\n\t\t\tInactive\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-value&quot;&gt;\n\t\t\t&lt;%=inactive_vehicles%&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;status-bar&quot;&gt;\n\t\t\t&lt;div\n\t\t\t\tclass=&quot;status-fill&quot;\n\t\t\t\tstyle=&quot;width:&lt;%=if(total_vehicles &gt; 0,inactive_vehicles * 100 / total_vehicles,0)%&gt;%;&quot;&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n\n\n&lt;!-- =========================\n     DETAILS\n     ========================= --&gt;\n\n&lt;div class=&quot;content-grid&quot;&gt;\n\n\n\t&lt;!-- TRIP STATUS --&gt;\n\n\t&lt;div class=&quot;panel&quot;&gt;\n\n\t\t&lt;h3&gt;Trip Status&lt;/h3&gt;\n\n\n\t\t&lt;div class=&quot;metric-row&quot;&gt;\n\t\t\t\n\t\t&lt;/div&gt;\n\n\t\t\n\n\t\t&lt;div class=&quot;metric-row&quot;&gt;\n\t\t\t&lt;a class=&quot;metric-action&quot; href=&quot;#Report:All_Trip_Details&quot;&gt;\n\t\t\t\tOpen All_Trip_Details \u2192\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;!-- VEHICLE TYPE --&gt;\n\n\t&lt;div class=&quot;panel&quot;&gt;\n\n\t\t&lt;h3&gt;Vehicle Type&lt;/h3&gt;\n\nl_count&lt;/span&gt;\n\t\t&lt;/div&gt;\n\n\t&lt;/div&gt;\n\n\n\t&lt;!-- DOCUMENT EXPIRY --&gt;\n\n\t&lt;div class=&quot;panel&quot;&gt;\n\n\t\t&lt;h3&gt;Document Expiry \u2014 Next 30 Days&lt;/h3&gt;\n\n\n\n&lt;!-- =========================\n     QUICK ACTIONS\n     ========================= --&gt;\n\n&lt;div class=&quot;section-title&quot;&gt;\n\t&lt;h2&gt;Quick Actions&lt;/h2&gt;\n\t&lt;span&gt;Open actual Creator forms&lt;/span&gt;\n&lt;/div&gt;\n\n\n&lt;div class=&quot;action-grid&quot;&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Vehicle_Details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDE99\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAdd Vehicle\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Diver_Details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDC64\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAdd Diver\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Empolyee_details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDC65\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAdd Employee\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Fuel_Details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\u26FD\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAdd Fuel\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Maintenance_details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDD27\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAdd Maintenance\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Trip_details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDEE3\uFE0F\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tCreate Trip\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Form:Vechicle_Docmuments&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDCC4\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tUpload Documents\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:All_Vehicle_Details&quot;&gt;\n\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\n\t\t\t\uD83D\uDCCA\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tVehicle Report\n\t\t&lt;/div&gt;\n\n\t&lt;/a&gt;\n\n&lt;/div&gt;\n\n\n&lt;!-- =========================\n     REPORT NAVIGATION\n     ========================= --&gt;\n\n&lt;div class=&quot;section-title&quot;&gt;\n\t&lt;h2&gt;Reports&lt;/h2&gt;\n\t&lt;span&gt;Actual reports from the export&lt;/span&gt;\n&lt;/div&gt;\n\n\n&lt;div class=&quot;action-grid&quot;&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:All_Vehicle_Details&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\uD83D\uDE99&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAll_Vehicle_Details\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:All_Diver_Details&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\uD83D\uDC64&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAll_Diver_Details\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:All_Fuel_Details&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\u26FD&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAll_Fuel_Details\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:Maintenance_details_Report&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\uD83D\uDD27&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tMaintenance_details_Report\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:All_Trip_Details&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\uD83D\uDEE3\uFE0F&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAll_Trip_Details\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:All_Empolyee_Details&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\uD83D\uDC65&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tAll_Empolyee_Details\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n\n\t&lt;a class=&quot;action-card&quot; href=&quot;#Report:Vechicle_Docmuments_Report&quot;&gt;\n\t\t&lt;div class=&quot;action-icon&quot;&gt;\uD83D\uDCC4&lt;/div&gt;\n\t\t&lt;div class=&quot;action-title&quot;&gt;\n\t\t\tVechicle_Docmuments_Report\n\t\t&lt;/div&gt;\n\t&lt;/a&gt;\n\n&lt;/div&gt;\n\n\n&lt;div class=&quot;dashboard-footer&quot;&gt;\n\tFleet Management System \u2022 Zoho Creator\n&lt;/div&gt;\n```\n\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
