			intergrate_form as "intergrate form"
			{
				type =  form
				form = Maintenance_details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											message_data = Map();
										message_data.put("text","🚗 FleetOps Test\n\nZoho Cliq connection is working successfully.");
										response = invokeurl
										[
											url :"https://cliq.zoho.in/api/v3/channels/O1230231000000002014/messages"
											type :POST
											parameters:message_data.toString()
											connection:"zoho_cliq_connection1"
											content-type:"application/json"
										];
										info response;
						)
					}
				}

			}
			Doc_Intergration as "Doc Intergration"
			{
				type =  form
				form = Vechicle_Docmuments

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											parent_folder_id = "z0x774378f33c67cf41ffa5227baa87b56109";
										vehicle_folder_name = input.Vehicle_No.Vehicle_No;
										vehicle_folder = zoho.workdrive.createFolder(vehicle_folder_name,parent_folder_id,"zoho_workdrive_connection");
										vehicle_folder_id = vehicle_folder.get("data").get("id");
										info vehicle_folder_id;
										// Insurance folder
										insurance_folder = zoho.workdrive.createFolder("Insurance",vehicle_folder_id,"zoho_workdrive_connection");
										insurance_folder_id = insurance_folder.get("data").get("id");
										info insurance_folder;
										// RC folder
										rc_folder = zoho.workdrive.createFolder("RC",vehicle_folder_id,"zoho_workdrive_connection");
										rc_folder_id = rc_folder.get("data").get("id");
										info rc_folder;
										// Pollution folder
										pollution_folder = zoho.workdrive.createFolder("Pollution Certificate",vehicle_folder_id,"zoho_workdrive_connection");
										pollution_folder_id = pollution_folder.get("data").get("id");
										info pollution_folder;
										// INSURANCE DOCUMENT UPLOAD
										if(input.Insurance_Certificate != null)
										{
											insurance_upload = zoho.workdrive.uploadFile(input.Insurance_Certificate,insurance_folder_id,input.Insurance_Certificate,true,"zoho_workdrive_connection");
											info insurance_upload;
										}
										// RC DOCUMENT UPLOAD
										if(input.Registration_Certificate != null)
										{
											rc_upload = zoho.workdrive.uploadFile(input.Registration_Certificate,rc_folder_id,input.Registration_Certificate,true,"zoho_workdrive_connection");
											info rc_upload;
										}
										// POLLUTION CERTIFICATE UPLOAD
										if(input.Pollution_Certificate != null)
										{
											pollution_upload = zoho.workdrive.uploadFile(input.Pollution_Certificate,pollution_folder_id,input.Pollution_Certificate,true,"zoho_workdrive_connection");
											info pollution_upload;
										}
						)
					}
				}

			}
