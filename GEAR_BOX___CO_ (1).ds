	datasources
	{
		zoho_crm_leads
		{
			displayname = "Zoho CRM Leads"
			module = Leads
			system connection = zohocrm
			annual_revenue
			(
				type = decimal
				displayname = "Annual Revenue"
				source field name = "Annual_Revenue"
				search operators = {"equals"}
			)
			city
			(
				type = text
				displayname = "City"
				source field name = "City"
				search operators = {"startsWith"}
			)
			must have company
			(
				type = text
				displayname = "Company"
				source field name = "Company"
				search operators = {"startsWith"}
			)
			country
			(
				type = text
				displayname = "Country"
				source field name = "Country"
				search operators = {"startsWith"}
			)
