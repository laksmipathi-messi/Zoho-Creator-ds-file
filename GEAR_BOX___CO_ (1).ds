				source field name = "Mobile"
				search operators = {"startsWith"}
			)
			no_of_employees
			(
				type = number
				displayname = "No of Employees"
				source field name = "No_of_Employees"
				search operators = {"equals"}
			)
			phone
			(
				type = text
				displayname = "Phone"
				source field name = "Phone"
				search operators = {"startsWith"}
			)
			rating
