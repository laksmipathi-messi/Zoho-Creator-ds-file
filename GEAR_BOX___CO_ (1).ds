		reports
		{
			report Brand_details_Report
			{
				quickview
				(
					layout
					(
						displaylayout = "classic"
		 				type = -2
	     				recordsperrow = 2
						datablock1
						(
							layout type = -2
							fields
							(
								Brand_Name as "Brand Name "
								Brand_Vendor as "Brand Vendor "
							)
						)
					)
						menu
