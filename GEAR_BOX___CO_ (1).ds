 application "GEAR BOX & CO "
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Brand_details
		{
			displayname = "Brand details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Brand_Name
			(
    			type = text
				displayname = "Brand Name "
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Brand_Vendor
			(
    			type = text
				displayname = "Brand Vendor "
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Brand_Product_Details
		{
			displayname = "Brand Product Details"
			success message = "Brand Product Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Brand_Name
			(
				type = picklist	
				displayname = "Brand Name "
				values  = Brand_details.ID
    			displayformat = [Brand_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Name
			(
    			type = text
				displayname = "Product Name "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Price
			(
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Customer_details
		{
			displayname = "Customer details"
			success message = "Customer Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Customer_ID
			(
    			type = text
				displayname = "Customer ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
    			type = name
				displayname = "Customer  Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Status
			(
				type = radiobuttons
				displayname = "Status "
				maxchar = 100
				values = {"New Customer","Exitsing  Customer"}
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Zoho_book_ID
			(
    			type = text
				displayname = "Zoho book ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 3   
				width = medium
				personal data = true
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 1
	 			column = 3   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Existing_master
		{
			displayname = "Existing  master"
			success message = "Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			serial_no
			(
				type = number
				displayname = "serial no"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			brand_Name
			(
				type = picklist	
				displayname = "brand  Name "
				values  = Brand_details.ID
    			displayformat = [Brand_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product_Name
			(
				type = picklist	
				displayname = "Product  Name "
				values  = Brand_Product_Details.ID
    			displayformat = [Product_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			NO_of_count
			(
				type = number
				displayname = "NO   of  count"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Price
			(
				displayname = "Price "
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Price
			(
				displayname = "Total Price"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Existing"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form price_details
		{
			displayname = "price details"
			success message = "Price Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Purchase_Price
			(
				displayname = "Purchase Price "
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			selling_price
			(
				displayname = "selling price "
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Discount
			(
				type = decimal
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Sales_Details
		{
			displayname = "Sales  Details"
			success message = "Purchase Detail Added Successfully"
			Customer_Details
			(
				type = section
				displayname = "Customer Details "
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Customer_Phone_NO
			(
				type = picklist	
				displayname = "Customer Phone  NO"
				values  = Customer_details.ID
    			displayformat = [Phone_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
    			type = text
				displayname = "Customer name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Vendor_details
			(
				type = section
				displayname = "Vendor details "
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Vendor_ID
			(
				type = picklist	
				displayname = "Vendor  ID "
				values  = Vendor_Register.ID
    			displayformat = [Vendor_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Vendor_name
			(
    			type = text
				displayname = "Vendor  name "
	 			row = 2
	 			column = 2   
				width = medium
			)
			Sales_Date
			(
    			type = date
				displayname = "Sales Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 1,2,3,4,5,6
	 			row = 2
	 			column = 3   
				width = medium
			)
			Product_details
			(
				type = grid
				displayname = "Product  details"
				values  = Existing_master.ID
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Stock_details
		{
			displayname = "Stock details"
			success message = "Stock Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			opening_Stock
			(
				type = number
				displayname = "opening Stock"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Stock
			(
				type = number
				displayname = "Current  Stock"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reorder_Stock
			(
				type = number
				displayname = "Reorder Stock"
				initial value = 10
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Vehicle_details
		{
			displayname = "Vehicle details"
			success message = "Vehicle Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			vehicle_Model
			(
    			type = text
				displayname = "vehicle  Model"
	 			row = 1
	 			column = 1   
				width = medium
			)
			vehicle_variants
			(
    			type = text
				displayname = "vehicle variants"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
