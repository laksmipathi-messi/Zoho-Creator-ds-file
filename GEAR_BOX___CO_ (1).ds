			Gst_validations as "Gst validations"
			{
				type =  form
				form = Vendor_purchase_master

				record event = on add or edit

				on user input of Gst_NO
				{
					actions 
					{
						custom deluge script
						(
											if(input.Gst_NO != null && input.Gst_NO != "")
										{
											gst = input.Gst_NO.toUpperCase();
											if(!gst.matches("[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]"))
											{
												alert "Enter a valid GST Number";
												input.Gst_NO = "";
											}
										}
						)
					}
				}

			}
			validate_invoice as "validate invoice"
			{
				type =  form
				form = Vendor_purchase_master

				record event = on add or edit

				on user input of invoice_No
				{
					actions 
					{
						custom deluge script
						(
											if(input.invoice_No != null && input.invoice_No != "")
										{
											existing = Vendor_purchase_master[invoice_No == input.invoice_No];
											if(existing.count() > 0)
											{
												alert "Invoice Number already exists";
												input.invoice_No = "";
											}
										}
						)
					}
				}

			}
			validate_pur_date as "validate pur date"
			{
				type =  form
				form = Vendor_purchase_master

				record event = on add or edit

				on user input of purchase_date
				{
					actions 
					{
						custom deluge script
						(
											if(input.purchase_date > zoho.currentdate)
										{
											alert "Purchase Date cannot be a future date";
											input.purchase_date = null;
										}
						)
					}
				}

			}
			item_integration as "item integration"
			{
				type =  form
				form = Brand_Product_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											itemMap = Map();
										itemMap.put("brand_name",input.Brand_Name.Brand_Name);
										itemMap.put("name",input.Product_Name);
										itemMap.put("rate",input.Price);
										response = invokeurl
										[
											url :"https://www.zohoapis.in/books/v3/items?organization_id=60077296437"
											type :POST
											parameters:itemMap.toString()
											connection:"zoho_books_connection"
										];
										// info itemMap;
										// info "-------------------------";
										// info response;
						)
					}
				}

			}
			test as "test"
			{
				type =  form
				form = Customer_details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Phone_Number != null)
										{
											customerMap = Map();
											customerMap.put("contact_name",input.Customer_ID);
											customerMap.put("company_name",input.Customer_Name);
											customerMap.put("contact_type","customer");
											customerMap.put("first_name",input.Customer_Name.first_name);
											customerMap.put("last_name",input.Customer_Name.last_name);
											customerMap.put("salutation",input.Customer_Name.prefix);
											customer_list = List();
											empty_map = Map();
											empty_map.put("email",input.Email);
											empty_map.put("phone",input.Phone_Number);
											customer_list.add(empty_map);
											customerMap.put("contact_persons",customer_list);
											responses = invokeurl
											[
												url :"https://www.zohoapis.in/books/v3/contacts?organization_id=60077296437"
												type :POST
												parameters:customerMap.toString()
												connection:"zoho_books_connection"
											];
											info responses;
											var = responses.get("contact").get("contact_id");
											input.Zoho_book_ID = var;
											//
										}
										else
										{
											Fetch_ustomer_ID = Customer_details[Email == input.Email];
											input.Zoho_book_ID = Fetch_ustomer_ID.Zoho_book_ID;
										}
						)
					}
				}

			}
